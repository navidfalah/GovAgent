# GovAgents Environment Configuration
# Copy this file to .env and fill in your API keys

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Provider: gemini | openai | anthropic | groq | ollama
LLM_PROVIDER=gemini

# Gemini model to use
LLM_MODEL=gemini/gemini-2.0-flash

# Your Gemini API key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: OpenAI-compatible endpoint (for Ollama, vLLM, etc.)
# LLM_BASE_URL=http://localhost:11434

# ── Vector Database ────────────────────────────────────────────────────────────
# Path to ChromaDB storage (will be created if not exists)
CHROMA_PATH=./data/chroma

# ── Embedding Model ────────────────────────────────────────────────────────────
# HuggingFace sentence-transformers model name
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Governance Settings ────────────────────────────────────────────────────────
# Minimum confidence for non-abstention decision (0.0-1.0)
ABSTENTION_THRESHOLD=0.45

# Maximum debate rounds between agents
MAX_DEBATE_ROUNDS=2

# Number of policy chunks to retrieve per query
RETRIEVAL_TOP_K=5

# ── API Settings ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console  # console | json
